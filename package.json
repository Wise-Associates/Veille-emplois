{
  "name": "veille-marches-emplois",
  "version": "1.0.0",
  "private": true,
  "description": "Veille quotidienne des appels d'offres et des offres d'emploi de 14 organismes publics, envoyée par e-mail.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node -e \"require('node:fs').rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test --enable-source-maps \"dist-test/**/*.spec.js\"",
    "veille": "node --enable-source-maps dist/main.js",
    "veille:essai": "node --enable-source-maps dist/main.js --dry-run",
    "veille:local": "node --env-file=.env --enable-source-maps dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "cheerio": "1.2.0",
    "nodemailer": "10.0.16",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "typescript": "6.0.3"
  }
}
